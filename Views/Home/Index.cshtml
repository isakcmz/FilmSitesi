@model List<FilmSitesi.Web.Models.ViewModels.ActivityViewModel>

<h2>Aktiviteler</h2>

@if (Model.Any())
{
    foreach (var activity in Model)
    {
        <div class="card mb-2">
            <div class="card-body">

                <strong>@activity.UserName</strong>

                @if (activity.Type == "Review")
                {
                    <span>
                        <a asp-controller="Movies"
                           asp-action="Detail"
                           asp-route-id="@activity.MovieTmdbId">
                           @activity.MovieTitle
                        </a>
                        filmine yorum yaptı
                    </span>
                }

                @if (activity.Type == "Watched")
                {
                    <span>
                        <a asp-controller="Movies"
                           asp-action="Detail"
                           asp-route-id="@activity.MovieTmdbId">
                           @activity.MovieTitle
                        </a>
                        filmini izledi
                    </span>
                }

                @if (activity.Type == "Watchlist")
                {
                    <span>
                        <a asp-controller="Movies"
                           asp-action="Detail"
                           asp-route-id="@activity.MovieTmdbId">
                           @activity.MovieTitle
                        </a>
                        filmini watchlist'e ekledi
                    </span>
                }

                <div>
                    <small class="text-muted">
                        @activity.CreatedAt.ToLocalTime()
                    </small>
                </div>

            </div>
        </div>
    }
}
else
{
    <p>Henüz aktivite yok.</p>
}