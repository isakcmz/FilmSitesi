@model FilmSitesi.Web.Models.ViewModels.MovieDetailViewModel

@{
    ViewData["Title"] = "Film Detayı";
}

<h1>@Model.Movie.Title</h1>

<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrWhiteSpace(Model.Movie.PosterPath))
        {
            <img class="img-fluid"
                 src="@($"https://image.tmdb.org/t/p/w500{Model.Movie.PosterPath}")"
                 alt="@Model.Movie.Title" />
        }
    </div>

    <div class="col-md-8">
        <p><strong>Orijinal Ad:</strong> @Model.Movie.OriginalTitle</p>
        <p><strong>Çıkış Tarihi:</strong> @(Model.Movie.ReleaseDate?.ToString("dd.MM.yyyy") ?? "-")</p>
        <p><strong>Dil:</strong> @Model.Movie.OriginalLanguage</p>
        <p><strong>TMDb Puanı:</strong> @Model.Movie.VoteAverage.ToString("0.0")</p>
        <p><strong>Açıklama:</strong> @Model.Movie.Overview</p>
        <p>
            <strong>Kullanıcı Puanı:</strong>

            @if (Model.RatingCount > 0)
            {
                <span>
                    ⭐ @Model.AverageRating.ToString("0.0") / 5
                    (@Model.RatingCount kişi)
                </span>
            }
            else
            {
                <span>Henüz puan yok</span>
            }
        </p>
    </div>
</div>


<hr />


@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <h3>İzledim</h3>

    @if (Model.HasWatched)
    {
        <p><strong>Bu filmi @Model.WatchedCount kez izledin.</strong></p>
    }

    <form asp-action="AddWatched" method="post" class="mb-3">
        <input type="hidden" name="movieId" value="@Model.Movie.Id" />

        <div class="mb-3">
            <label class="form-label">İzleme Notu</label>
            <textarea name="notes" class="form-control" rows="3">@Model.WatchedNotes</textarea>
        </div>

        <button type="submit" class="btn btn-success">
            @(Model.HasWatched ? "Tekrar İzledim Olarak Ekle" : "İzledim Olarak İşaretle")
        </button>
    </form>
}
else
{
    <p>
        İzledim listesi kullanmak için
        <a asp-area="Identity" asp-page="/Account/Login">giriş yap</a>.
    </p>
}


<hr />


@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <h3>Watchlist</h3>

    @if (TempData["WatchlistError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["WatchlistError"]
        </div>
    }

    <form asp-action="AddToWatchlist" method="post" class="mb-3">
        <input type="hidden" name="movieId" value="@Model.Movie.Id" />

        <div class="mb-3">
            <label class="form-label">Öncelik</label>
            <select name="priority" class="form-select">
                <option value="1" selected="@(Model.WatchlistPriority == 1 ? "selected" : null)">1 - Çok yüksek</option>
                <option value="2" selected="@(Model.WatchlistPriority == 2 ? "selected" : null)">2 - Yüksek</option>
                <option value="3" selected="@(Model.WatchlistPriority == 3 ? "selected" : null)">3 - Orta</option>
                <option value="4" selected="@(Model.WatchlistPriority == 4 ? "selected" : null)">4 - Düşük</option>
                <option value="5" selected="@(Model.WatchlistPriority == 5 ? "selected" : null)">5 - Çok düşük</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Not</label>
            <textarea name="notes" class="form-control" rows="3">@Model.WatchlistNotes</textarea>
        </div>

        <button type="submit" class="btn btn-warning">
            @(Model.IsInWatchlist ? "Watchlist'i Güncelle" : "Watchlist'e Ekle")
        </button>
    </form>

    @if (Model.IsInWatchlist)
    {
        <form asp-action="RemoveFromWatchlist" method="post">
            <input type="hidden" name="movieId" value="@Model.Movie.Id" />
            <button type="submit" class="btn btn-outline-danger">Watchlist'ten Çıkar</button>
        </form>
    }
}
else
{
    <p>
        Watchlist kullanmak için
        <a asp-area="Identity" asp-page="/Account/Login">giriş yap</a>.
    </p>
}




@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <h3>Puan Ver / Yorum Yaz</h3>

    @if (TempData["ReviewError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ReviewError"]
        </div>
    }

    <form asp-action="AddReview" method="post">
        <input type="hidden" name="movieId" value="@Model.Movie.Id" />

        <div class="mb-3">
            <label class="form-label">Puan</label>
            <select name="rating" class="form-select" required>
                <option value="">Seçiniz</option>
                <option value="0.5">0.5</option>
                <option value="1">1</option>
                <option value="1.5">1.5</option>
                <option value="2">2</option>
                <option value="2.5">2.5</option>
                <option value="3">3</option>
                <option value="3.5">3.5</option>
                <option value="4">4</option>
                <option value="4.5">4.5</option>
                <option value="5">5</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Yorum</label>
            <textarea name="comment" class="form-control" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Kaydet</button>
    </form>
}
else
{
    <p>
        Yorum ve puan vermek için
        <a asp-area="Identity" asp-page="/Account/Login">giriş yap</a>.
    </p>
}

<hr />

<h3>Yorumlar</h3>

@if (Model.Reviews.Any())
{
    foreach (var review in Model.Reviews)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@review.User.UserName</h5>
                <h6 class="card-subtitle mb-2 text-muted">
                    Puan: @review.Rating / 5
                </h6>
                <p class="card-text">@review.Comment</p>
                <small class="text-muted">@review.CreatedAt.ToLocalTime()</small>
            </div>
        </div>
    }
}
else
{
    <p>Henüz yorum yok.</p>
}